# Copy to .env and adjust as needed: cp .env.example .env
# All data lives under the repo's data/ folder; compose reads this file when you run from repo root with -f docker/docker-compose.yml (use docker/.env).

# --- Postgres (used by the postgres container only) ---
POSTGRES_USER=adsb
POSTGRES_PASSWORD=adsb
POSTGRES_DB=adsb

# --- API + data-loading: how they connect to the DB ---
# Bundled Postgres (default): leave DOCKER_DATABASE_URL unset; api uses DB_* (host "postgres").
#
# Postgres on your Mac / outside Docker: containers cannot use localhost — use host.docker.internal
# (Docker Desktop Mac/Win; Linux: extra_hosts is set in compose). Prefer:
#   DOCKER_DATABASE_URL=postgresql://postgres:YOURPASS@host.docker.internal:5432/adsb
# and run with BOTH files so nothing binds host :5432 twice:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
#
# Host-only tools (uv/python on your machine): localhost is fine, e.g.
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/adsb
DB_HOST=postgres
DB_NAME=adsb
DB_USER=adsb
DB_PASS=adsb
DB_PORT=5432
# DOCKER_DATABASE_URL=postgresql://postgres:pass@host.docker.internal:5432/adsb

DISABLE_AUTH=1
QUERY_HISTORY_BACKUP_PATH=/data/query-history-backup.json
FIREBASE_SERVICE_ACCOUNT_KEY=/app/firebase-key.json

# --- Frontend build args (API URL as seen by the browser) ---
# Leave empty for Docker: frontend container proxies /api to api:5000 (same-origin).
# For local dev or external access set e.g. http://localhost:5000 or http://host:5000
VITE_API_BASE_URL=
VITE_DISABLE_AUTH=1

# --- Host ports (left side of host:container; container ports stay 5432, 5000, 80) ---
# POSTGRES_PORT=5432
# API_PORT=5000
# FRONTEND_PORT=8080
